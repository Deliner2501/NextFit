# Copia este archivo como nextfit.properties (en la carpeta del proyecto) y completa la clave.
# nextfit.properties NO se sube a GitHub.
db.url=jdbc:oracle:thin:@nextfit_tp?TNS_ADMIN=C:/ruta/al/wallet/NEXTFIT
db.user=NEXTFIT_APP
db.password=PON_AQUI_LA_CLAVE_DE_NEXTFIT_APP

# true = use the Oracle database (needs the db.* lines above and the tables from OracleSchemaInstaller).
# false or missing = NextFit works with the CSV files.
db.enabled=false

# Optional HTTPS origin for the QR cards. Both installations must use the same Oracle database.
# portal.publicUrl=https://portal.example.com

# Use the independent Wi-Fi server instead of starting one with the desktop.
# portal.standaloneLan=true
# portal.lanPort=8765
